{
  "name": "aegis-blockchain",
  "version": "1.0.0",
  "description": "Blockchain contracts for AEGIS - Immutable audit trails via smart contracts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:watch": "hardhat test --watch",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "start:private": "node start-private-network.js",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:private": "hardhat run scripts/deploy.js --network private",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo:multi-customer": "hardhat run scripts/multi-customer-demo.js --network hardhat",
    "demo:single": "hardhat run scripts/deploy-and-test.js --network hardhat",
    "verify": "hardhat verify",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "chai": "^4.3.10",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.5",
    "dotenv": "^16.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
